{
  "name": "loomy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cursor:sync": "node scripts/sync-loomy-cursor.mjs",
    "dev": "next dev --turbo -H 0.0.0.0 -p 3000",
    "build": "next build",
    "postbuild": "node scripts/verify-site.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "verify:site": "node scripts/verify-site.mjs",
    "lint": "eslint",
    "supabase:start": "npx --yes supabase@latest start",
    "supabase:stop": "npx --yes supabase@latest stop",
    "supabase:db:reset": "npx --yes supabase@latest db reset",
    "supabase:migrate:remote": "npx --yes supabase@latest db push",
    "supabase:link": "npx --yes supabase@latest link"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "@supabase/supabase-js": "^2.104.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
