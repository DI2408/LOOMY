NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL (used for Stripe Checkout success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only (Vercel / local) — for partner ID → email before login (bypasses RLS).
# Get from Supabase: Project Settings → API → service_role (keep secret).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server only — never expose to browser)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Connect: map LOOMY store_id → Stripe connected account id (acct_…)
# Example: {"strom-boutique":"acct_123","naked-copenhagen-edit":"acct_456"}
# Leave empty (or set LOOMY_STRIPE_PLATFORM_ONLY=true) to charge on the platform account until Connect is ready.
LOOMY_STORE_STRIPE_ACCOUNTS=

# Optional: force Stripe Checkout without Connect (all revenue to platform Stripe account).
# LOOMY_STRIPE_PLATFORM_ONLY=true

# Optional: platform fee in basis points (default 100 = 1%). Must be < 10000.
# LOOMY_PLATFORM_FEE_BPS=100

# Set to 1 to allow demo courier ID→email mapping when service role is not set (dev only).
# LOOMY_COURIER_DEMO_MAP=0

# Optional demo flag for seeded customer demo profiles (documentation aid).
# LOOMY_CUSTOMER_DEMO_MAP=1

# Allow POST /api/auth/demo-customer on production (magic-link OTP exchange for Emma/Noah/Sofie).
# Required on Vercel if demo customer login should create a real Supabase session.
# LOOMY_ALLOW_DEMO_AUTH=true
